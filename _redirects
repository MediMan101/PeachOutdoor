# Redirects from old dealer CMS platform to new Netlify site
# Old inventory listing pages -> new inventory page
/mowers-tractors-utvs-for-sale--xAllInventory         /inventory.html   301
/mowers-tractors-utvs-for-sale--xAllInventory*        /inventory.html   301
/default.asp                                           /inventory.html   301

# Old individual unit detail pages -> inventory
/New-Inventory-*                                       /inventory.html   301
/Used-Inventory-*                                      /inventory.html   301

# Old hours/location/about pages -> about page
/--hours                                               /about.html       301
/mowers-tractors-utvs-dealership--hours-service-center /about.html      301
/mowers-tractors-utvs-dealership--hours*               /about.html      301

# Old showroom/configurator style pages -> configurator
/inventory/v1                                          /configurator.html 301
/inventory/*                                           /inventory.html   301

# Old financing pages -> financing
/financing*                                            /financing.html   301
/apply*                                                /financing.html   301

# Anything else is genuinely missing, so say so with a real 404.
#
# This used to be "/* /index.html 200", which served the home page with an
# HTTP 200 for every unknown URL. Search engines call that a soft 404: the
# status says "here is the page you asked for" while the body is something
# else entirely. It wastes crawl budget on URLs that don't exist, and it can
# get junk paths indexed as duplicates of the home page.
#
# Netlify applies redirect rules only when no real file matches, so this rule
# never shadows a page, a pre-rendered item under /inventory/, or an asset.
/*                                                     /404.html         404

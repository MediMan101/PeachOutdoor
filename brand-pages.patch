+                   '<span aria-current="page">' + escapeHtml(brand.name) + '</span>',
+        lede, lineup: renderLineup(brand, entries),
+        catNav: renderCatNav(live, null).replace('class="here"', 'class=""'),
+        brandNav: renderBrandNav(liveBrands, brand.slug),
+        jumps, sections
     });
 }
 
